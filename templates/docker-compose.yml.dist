services:
  service:
    build:
      context: .
      dockerfile: Dockerfile.service
    ports:
      - "8000:8000"
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  observer:
    build:
      context: .
      dockerfile: Dockerfile.observer
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - service
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  ui:
    image: wundii/flowcrafter-ui:latest
    ports:
      - '3000:3000'
    depends_on:
      - service
    volumes:
      - ui-data:/flowcrafter/data

volumes:
  observer-tmp:
  service-data:
  ui-data:
