services:
  service:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "service"]
    ports:
      - "8000:8000"
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  observer:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "observer", "--workers", "1"]
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - service
    healthcheck:
      test: ["CMD-SHELL", "find /tmp/flowcrafter -name '*.heartbeat' -mmin -1 -type f | grep -q ."]
      interval: 30s
      timeout: 5s
      retries: 3
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  ui:
    image: wundii/flowcrafter-ui:latest
    ports:
      - '3000:3000'
    depends_on:
      - service
    volumes:
      - ui-data:/flowcrafter/data

volumes:
  observer-tmp:
  service-data:
  ui-data:
