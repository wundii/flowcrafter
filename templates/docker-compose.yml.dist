services:
  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  service:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "service"]
    ports:
      - "8000:8000"
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - redis
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  observer:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "observer", "--workers", "1"]
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - service
      - redis
    healthcheck:
      test: ["CMD-SHELL", "find /tmp/flowcrafter -name '*.heartbeat' -mmin -1 -type f | grep -q ."]
      interval: 30s
      timeout: 5s
      retries: 3
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  scheduler:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "scheduler"]
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - service
      - redis
    healthcheck:
      test: ["CMD-SHELL", "find /tmp/flowcrafter -name '*.heartbeat' -mmin -1 -type f | grep -q ."]
      interval: 30s
      timeout: 5s
      retries: 3
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  projection-worker:
    build:
      context: .
      dockerfile: Dockerfile
    command: ["vendor/bin/flowcrafter", "projection:worker"]
    environment:
      FLOWCRAFTER_CONFIG: /app/flowcrafter.php
    depends_on:
      - service
      - redis
    healthcheck:
      test: ["CMD-SHELL", "find /tmp/flowcrafter -name '*.heartbeat' -mmin -1 -type f | grep -q ."]
      interval: 30s
      timeout: 5s
      retries: 3
    volumes:
      - observer-tmp:/tmp/flowcrafter
      - service-data:/app/data

  ui:
    image: wundii/flowcrafter-ui:latest
    ports:
      - '5173:5173'
    depends_on:
      - service
    volumes:
      - ui-data:/flowcrafter/data

volumes:
  observer-tmp:
  service-data:
  ui-data:
  redis-data:
