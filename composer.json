{
  "name": "wundii/flowcrafter",
  "type": "library",
  "description": "PHP library for defining, executing, and monitoring message-driven workflows (state machines)",
  "keywords": ["workflow", "state-machine", "message-driven", "flow", "orchestration"],
  "license": "MIT",
  "authors": [
    {
      "name": "Andreas Wunderwald",
      "email": "wundii@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ramsey/uuid": "^4.9.2",
    "symfony/config": "^6.4 | ^7.0 | ^8.0.8",
    "symfony/console": "^6.4 | ^7.0 | ^8.0.7",
    "symfony/dependency-injection": "^6.4 | ^7.0 | ^8.0.8",
    "symfony/filesystem": "^6.4 | ^7.0 | ^8.0.6",
    "symfony/http-foundation": "^6.4 | ^7.0 | ^8.0.7",
    "symfony/process": "^6.4 | ^7.0 | ^8.0.5",
    "symfony/routing": "^6.4 | ^7.0 | ^8.0.6",
    "wundii/data-mapper": "^1.5.0"
  },
  "suggest": {
    "ext-redis": "Required for the Redis storage backend"
  },
  "require-dev": {
    "ext-redis": "*",
    "phpstan/phpstan": "^2.1.45",
    "phpunit/phpunit": "^11.5.55",
    "rector/rector": "^2.3.9",
    "symfony/var-dumper": "^6.4 | ^7.0 | ^8.0.6",
    "symplify/easy-coding-standard": "^12.6.2",
    "testcontainers/testcontainers": "^1.0.4",
    "thenativeweb/eventsourcingdb": "^1.4.1",
    "wundii/phplint": "^0.3.4"
  },
  "autoload": {
    "psr-4": {
      "Wundii\\Flower\\": "service/Flower/",
      "Wundii\\Service\\": "service/",
      "Wundii\\Flowcrafter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyze": [
      "vendor/bin/rector process --dry-run --ansi",
      "vendor/bin/ecs check",
      "@stan"
    ],
    "format": [
      "vendor/bin/rector process",
      "vendor/bin/ecs check --fix"
    ],
    "phplint": "vendor/bin/phplint",
    "stan": "vendor/bin/phpstan analyze",
    "qa": [
      "@analyze",
      "@test"
    ],
    "test": "vendor/bin/phpunit"
  },
  "bin": [
    "bin/flowcrafter"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "bump-after-update": true
  }
}
